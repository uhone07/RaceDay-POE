@model RaceDay.Web.Models.EventDetailsViewModel
@{
    var ev = Model.Event;
    ViewData["Title"] = ev.Name;
}

<a class="btn btn-link ps-0" asp-action="Index">&larr; Back to events</a>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row">
    <div class="col-md-8">
        @if (!string.IsNullOrEmpty(ev.BannerImageUrl))
        {
            <img src="@ev.BannerImageUrl" class="img-fluid rounded mb-3" alt="Event banner" />
        }
        <h2>@ev.Name <span class="badge bg-info text-dark">@ev.EventType</span></h2>
        <p class="text-muted">@ev.EventDate.ToString("dddd, dd MMMM yyyy HH:mm") &middot; @ev.Location &middot; @ev.DistanceKm km</p>
        <p>@ev.Description</p>

        <h5 class="mt-4">Categories</h5>
        @if (ev.Categories.Count == 0)
        {
            <p class="text-muted">The organiser has not added any categories yet.</p>
        }
        else
        {
            <table class="table">
                <thead><tr><th>Name</th><th>Ages</th><th>Distance</th></tr></thead>
                <tbody>
                    @foreach (var c in ev.Categories)
                    {
                        <tr>
                            <td>@c.Name</td>
                            <td>@c.AgeText</td>
                            <td>@(c.DistanceKm.HasValue ? c.DistanceKm + " km" : "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Enrol</h5>

                @if (Model.Enrolment != null)
                {
                    <p>You are enrolled in <strong>@Model.Enrolment.CategoryName</strong>.</p>
                    <span class="badge @Model.Enrolment.BadgeClass">@Model.Enrolment.Status</span>
                    <div class="mt-3">
                        <a class="btn btn-outline-secondary btn-sm" asp-controller="MyEnrolments" asp-action="Index">My enrolments</a>
                    </div>
                }
                else if (ev.Categories.Count == 0)
                {
                    <p class="text-muted">You can enrol once the organiser adds categories.</p>
                }
                else
                {
                    <form asp-action="Enrol" asp-route-id="@ev.EventId" method="post">
                        @foreach (var c in ev.Categories)
                        {
                            var info = c.AgeText + (c.DistanceKm.HasValue ? ", " + c.DistanceKm + " km" : "");
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="radio" name="categoryId" id="cat@(c.CategoryId)" value="@c.CategoryId" required />
                                <label class="form-check-label" for="cat@(c.CategoryId)">@c.Name <small class="text-muted">(@info)</small></label>
                            </div>
                        }
                        <button class="btn btn-primary w-100 mt-2">Enrol now</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>