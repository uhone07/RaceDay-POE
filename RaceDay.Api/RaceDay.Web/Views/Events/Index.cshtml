@model RaceDay.Web.Models.EventsListViewModel
@{
    ViewData["Title"] = "Events";
}

<h2 class="mb-3">Upcoming events</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form method="get" class="row g-2 mb-4 align-items-center">
    <div class="col-md-4">
        <input name="search" value="@Model.Search" class="form-control" placeholder="Search name or location" />
    </div>
    <div class="col-md-2">
        <select name="type" class="form-select">
            <option value="">All types</option>
            @foreach (var t in new[] { "Run", "Walk", "Cycle" })
            {
                <option value="@t" selected="@(t == Model.Type)">@t</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <input name="maxDistance" value="@Model.MaxDistance" type="number" step="0.1" class="form-control" placeholder="Max km" />
    </div>
    <div class="col-md-2">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" name="includePast" value="true" id="includePast" checked="@Model.IncludePast" />
            <label class="form-check-label" for="includePast">Include past</label>
        </div>
    </div>
    <div class="col-md-2">
        <button class="btn btn-primary w-100">Filter</button>
    </div>
</form>

@if (Model.Events.Count == 0)
{
    <p class="text-muted">No events match your filters.</p>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var e in Model.Events)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrEmpty(e.BannerImageUrl))
                    {
                        <img src="@e.BannerImageUrl" class="card-img-top" alt="Event banner" style="height:160px;object-fit:cover" />
                    }
                    <div class="card-body">
                        <h5 class="card-title">@e.Name</h5>
                        <span class="badge bg-info text-dark mb-2">@e.EventType</span>
                        <p class="card-text mb-1">@e.EventDate.ToString("ddd, dd MMM yyyy HH:mm")</p>
                        <p class="card-text text-muted">@e.Location &middot; @e.DistanceKm km</p>
                    </div>
                    <div class="card-footer bg-white border-0">
                        <a class="btn btn-primary btn-sm" asp-action="Details" asp-route-id="@e.EventId">View details</a>
                    </div>
                </div>
            </div>
        }
    </div>
}