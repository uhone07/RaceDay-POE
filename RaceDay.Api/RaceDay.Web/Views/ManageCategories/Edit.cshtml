@model RaceDay.Web.Models.CategoryFormViewModel
@{
    ViewData["Title"] = "Edit category";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <h2 class="mb-3">Edit category</h2>
        <form asp-action="Edit" asp-route-eventId="@Model.EventId" asp-route-id="@Model.CategoryId" method="post">
            <partial name="_CategoryFields" model="Model" />
            <button type="submit" class="btn btn-primary">Save changes</button>
            <a class="btn btn-link" asp-action="Index" asp-route-eventId="@Model.EventId">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}