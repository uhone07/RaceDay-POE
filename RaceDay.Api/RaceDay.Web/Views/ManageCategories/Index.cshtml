@model RaceDay.Web.Models.CategoryListViewModel
@{
    ViewData["Title"] = "Categories";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Categories</h2>
        <span class="text-muted">@Model.EventName</span>
    </div>
    <div>
        <a class="btn btn-outline-secondary" asp-controller="ManageEvents" asp-action="Index">Back to events</a>
        <a class="btn btn-primary" asp-action="Create" asp-route-eventId="@Model.EventId">+ New category</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (Model.Categories.Count == 0)
{
    <p class="text-muted">This event has no categories yet. Participants need a category to enrol.</p>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr><th>Name</th><th>Ages</th><th>Distance</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var c in Model.Categories)
            {
                <tr>
                    <td>@c.Name</td>
                    <td>@c.AgeText</td>
                    <td>@(c.DistanceKm.HasValue ? c.DistanceKm + " km" : "-")</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-eventId="@Model.EventId" asp-route-id="@c.CategoryId">Edit</a>
                        <form asp-action="Delete" asp-route-eventId="@Model.EventId" asp-route-id="@c.CategoryId" method="post" class="d-inline"
                              onsubmit="return confirm('Delete this category?');">
                            <button class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}