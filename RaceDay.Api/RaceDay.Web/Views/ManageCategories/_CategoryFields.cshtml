@model RaceDay.Web.Models.CategoryFormViewModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<div class="mb-3">
    <label asp-for="Name" class="form-label"></label>
    <input asp-for="Name" class="form-control" placeholder="e.g. Under 20, Senior, 10km" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>
<div class="row">
    <div class="col-md-4 mb-3">
        <label asp-for="MinAge" class="form-label"></label>
        <input asp-for="MinAge" class="form-control" />
        <span asp-validation-for="MinAge" class="text-danger"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="MaxAge" class="form-label"></label>
        <input asp-for="MaxAge" class="form-control" />
        <span asp-validation-for="MaxAge" class="text-danger"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="DistanceKm" class="form-label"></label>
        <input asp-for="DistanceKm" class="form-control" />
        <span asp-validation-for="DistanceKm" class="text-danger"></span>
    </div>
</div>
<p class="text-muted small">Leave ages or distance empty if they do not apply.</p>