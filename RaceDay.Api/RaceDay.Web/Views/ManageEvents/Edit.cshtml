@model RaceDay.Web.Models.EventFormViewModel
@{
    ViewData["Title"] = "Edit event";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <h2 class="mb-3">Edit event</h2>
        <form asp-action="Edit" asp-route-id="@Model.EventId" method="post">
            <input type="hidden" asp-for="EventId" />
            <input type="hidden" asp-for="BannerImageUrl" />
            <partial name="_EventFields" model="Model" />
            <button type="submit" class="btn btn-primary">Save changes</button>
            <a class="btn btn-link" asp-action="Index">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}