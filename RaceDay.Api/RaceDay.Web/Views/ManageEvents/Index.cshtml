@model List<RaceDay.Web.Models.EventListItem>
@{
    ViewData["Title"] = "My events";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>My events</h2>
    <a class="btn btn-primary" asp-action="Create">+ New event</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (Model.Count == 0)
{
    <p class="text-muted">You have not created any events yet.</p>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr><th>Name</th><th>Date</th><th>Location</th><th>Distance</th><th>Type</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var e in Model)
            {
                <tr>
                    <td>@e.Name</td>
                    <td>@e.EventDate.ToString("dd MMM yyyy HH:mm")</td>
                    <td>@e.Location</td>
                    <td>@e.DistanceKm km</td>
                    <td><span class="badge bg-info text-dark">@e.EventType</span></td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@e.EventId">Edit</a>
                        <form asp-action="Delete" asp-route-id="@e.EventId" method="post" class="d-inline"
                              onsubmit="return confirm('Delete this event?');">
                            <button class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}