@model RaceDay.Web.Models.ResultFormViewModel
@{
    ViewData["Title"] = "Capture result";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <h2 class="mb-3">Capture result</h2>
        <form asp-action="Create" asp-route-eventId="@Model.EventId" asp-route-enrolmentId="@Model.EnrolmentId" method="post">
            <partial name="_ResultFields" model="Model" />
            <button type="submit" class="btn btn-primary">Save result</button>
            <a class="btn btn-link" asp-controller="ManageEnrolments" asp-action="Index" asp-route-eventId="@Model.EventId">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}