@model RaceDay.Web.Models.ProfileFormViewModel
@{
    ViewData["Title"] = "My profile";
    var initial = string.IsNullOrEmpty(Model.FullName) ? "?" : Model.FullName.Substring(0, 1).ToUpper();
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <h2 class="mb-3">My profile</h2>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        <div class="text-center mb-4">
            @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
            {
                <img src="@Model.ProfilePictureUrl" alt="Profile picture" class="rounded-circle"
                     style="width:120px;height:120px;object-fit:cover" />
            }
            else
            {
                <div class="rounded-circle bg-secondary text-white d-inline-flex align-items-center justify-content-center"
                     style="width:120px;height:120px;font-size:2.5rem">
                    @initial
                </div>
            }
        </div>

        <form asp-action="Index" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="Role" />
            <input type="hidden" asp-for="ProfilePictureUrl" />

            <div class="mb-3">
                <label class="form-label">Email</label>
                <input class="form-control" value="@Model.Email" disabled />
            </div>
            <div class="mb-3">
                <label class="form-label">Account type</label>
                <input class="form-control" value="@Model.Role" disabled />
            </div>
            <div class="mb-3">
                <label asp-for="FullName" class="form-label"></label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="PhoneNumber" class="form-label"></label>
                <input asp-for="PhoneNumber" class="form-control" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="PictureFile" class="form-label"></label>
                <input asp-for="PictureFile" class="form-control" accept="image/png,image/jpeg,image/webp,image/gif" />
                <div class="form-text">Optional. JPG, PNG, WEBP or GIF, up to 5 MB.</div>
                <span asp-validation-for="PictureFile" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Save changes</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}