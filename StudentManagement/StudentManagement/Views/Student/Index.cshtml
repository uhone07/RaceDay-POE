@model IEnumerable<StudentManagement.Models.Student>

@{
    ViewData["Title"] = "Students";
}

<h2>Student List</h2>

<h3>Add Student</h3>

<form asp-action="Create" method="post">
    <div class="mb-2">
        <label>Student Number</label>
        <input type="text" name="StudentNumber" class="form-control" required />
    </div>
    <div class="mb-2">
        <label>Name</label>
        <input type="text" name="Name" class="form-control" required />
    </div>
    <div class="mb-2">
        <label>Mark</label>
        <input type="number" name="Mark" class="form-control" min="0" max="100" required />
    </div>
    <button type="submit" class="btn btn-primary">Add Student</button>
</form>
<br />
<a asp-action="Export" class="btn btn-success mb-3">Export Students to CSV</a>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Student Number</th>
            <th>Name</th>
            <th>Mark</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var student in Model)
        {
            <tr>
                <td>@student.StudentNumber</td>
                <td>@student.Name</td>
                <td>@student.Mark</td>
            </tr>
        }
    </tbody>
</table>